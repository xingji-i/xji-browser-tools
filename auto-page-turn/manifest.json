{
  "manifest_version": 3,
  "name": "Auto Scroll - 自动翻页",
  "version": "1.2.0",
  "description": "自动平滑滚动网页，支持双向滚动、速度调节和键盘快捷键控制。",

  "permissions": ["activeTab", "storage"],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "自动翻页"
  },

  "commands": {
    "toggle-scroll": {
      "suggested_key": { "default": "Ctrl+Space", "mac": "MacCtrl+Space" },
      "description": "开始 / 停止自动滚动"
    },
    "turn-page": {
      "suggested_key": { "default": "Ctrl+Right", "mac": "MacCtrl+Right" },
      "description": "翻到下一页 Turn page"
    },
    "speed-up": {
      "suggested_key": { "default": "Ctrl+Shift+Up", "mac": "MacCtrl+Shift+Up" },
      "description": "加速 Speed up"
    },
    "speed-down": {
      "suggested_key": { "default": "Ctrl+Shift+Down", "mac": "MacCtrl+Shift+Down" },
      "description": "减速 Slow down"
    }
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "auto-scroll@autoscroller"
    }
  }
}
